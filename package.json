{
  "name": "react-architecture-intelligence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "build:launcher": "mkdir -p dist/rai && go build -o dist/rai/rai ./cmd/rai",
    "release:check": "tsx packages/cli/src/release-config-check.ts",
    "release:prepare": "./scripts/prepare-release-dry-run.sh",
    "test": "vitest run",
    "test:launcher": "go test ./...",
    "test:watch": "vitest",
    "lint:pr-title": "commitlint",
    "typecheck": "pnpm -r --sort run build && pnpm -r --sort run typecheck",
    "lint": "node scripts/check-core-framework-free.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  }
}
